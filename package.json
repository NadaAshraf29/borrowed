{
  "name": "borrowed-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @borrowed/web --filter @borrowed/api dev",
    "dev:web": "pnpm --filter @borrowed/web dev",
    "dev:api": "pnpm --filter @borrowed/api start:dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "prisma:generate": "pnpm --filter @borrowed/api prisma generate",
    "prisma:migrate": "pnpm --filter @borrowed/api prisma migrate dev",
    "prisma:seed": "pnpm --filter @borrowed/api prisma db seed",
    "prisma:studio": "pnpm --filter @borrowed/api prisma studio"
  },
  "devDependencies": {
    "eslint": "^9.20.0",
    "pnpm": "^10.4.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "prisma"
    ]
  }
}
